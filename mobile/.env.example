# Coach Conde: The Long Game — environment variables
#
# Copy this file to `.env` and fill in your own Supabase project's values.
# Only EXPO_PUBLIC_* vars are readable from the app bundle (Expo inlines
# them at build time) — never put a service-role key in this file or
# behind an EXPO_PUBLIC_ prefix. If these are left unset, the app boots in
# local demo mode automatically (mock auth + on-device storage, seeded from
# the same real program content) — see src/lib/demo/.

# Project Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> anon / public
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Which EAS build profile this is — 'development' | 'preview' | 'production'.
# Set automatically per-profile by eas.json; leave unset for local `expo start`
# (defaults to 'development'). A 'production' build with no Supabase URL/key
# refuses to start rather than silently falling back to demo mode — see
# src/lib/env.ts's `requiresBackend` / `isMisconfiguredProductionBuild`.
# EXPO_PUBLIC_APP_ENV=development

# Placeholders — fill in before a public App Store/Play Store submission.
# See docs/phase5/RELEASE_GUIDE.md's "Privacy/support requirements" section.
# EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
# EXPO_PUBLIC_SUPPORT_URL=https://example.com/support

# --- Server-side / CLI only — NEVER prefix with EXPO_PUBLIC_, never ship in the app ---
# Used only by scripts/seed-supabase.ts (run from a trusted machine/CI, not the app).
# SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase Edge Function only (supabase/functions/delete-account/) ---
# Set as Supabase project secrets (`supabase secrets set ...`), never in this
# file and never in the mobile app. See docs/phase5/RELEASE_GUIDE.md.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
